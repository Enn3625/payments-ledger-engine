# Copy to backend/.env for local development.
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:55432/ledger
TEST_DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:55432/ledger_test
ENVIRONMENT=local

# Shared secret the payment provider signs webhooks with. MUST be overridden
# with a real secret in any deployed environment.
WEBHOOK_SECRET=whsec_local_dev_secret
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
